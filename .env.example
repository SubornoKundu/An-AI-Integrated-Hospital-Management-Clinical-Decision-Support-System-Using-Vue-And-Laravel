APP_NAME="MediCare Hospital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hospital.test

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital
DB_USERNAME=root
DB_PASSWORD=

GROQ_API_KEY=your-groq-key-here

# Bootstrap admin login (email + password) — first admin account, auto-creates
# a StaffAdmin record on first successful login. Change the password after setup.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=admin123

# Gmail SMTP (free) — used to send password-reset codes.
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords (choose "Mail")
# 3. Paste the 16-character App Password below as MAIL_PASSWORD — NOT your normal Gmail password,
#    Gmail rejects normal passwords for SMTP.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=suborno52@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS=suborno52@gmail.com
MAIL_FROM_NAME="MediCare Hospital"

CACHE_DRIVER=file
SESSION_DRIVER=file
# Cookies are sent over HTTPS-only automatically when APP_ENV=production
# (see config/session.php), even if this is left unset. Override here only
# if that default is wrong for your setup (e.g. TLS terminated upstream).
# SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
